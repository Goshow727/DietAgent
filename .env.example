# App
APP_NAME=dietAgent
DEBUG=true

# Database (async, asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dietagent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM (Qwen / DashScope OpenAI compatible)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 首页饮食洞察总结（Deepseek，OpenAI 兼容）
# https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Banner：GET 日配额（东八区自然日）、红切保留天数、清理任务间隔与批量
# BANNER_GET_DAILY_LIMIT=20
# BANNER_REDCUT_RETENTION_DAYS=7
# BANNER_REDCUT_CLEANUP_INTERVAL_SECONDS=3600
# BANNER_REDCUT_CLEANUP_BATCH_SIZE=500

[Unit]
Description=DietAgent FastAPI Service
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/DietAgent
EnvironmentFile=/root/DietAgent/.env

ExecStart=/root/.local/bin/uv run uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dietagent

[Install]
WantedBy=multi-user.target
